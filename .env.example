# Server
PORT=3000
NODE_ENV=development

# Comma-separated API key(s) that callers of THIS API must send via the
# X-Api-Key header. Leave empty during local development if you want; never
# leave it empty in production.
API_KEYS=change-me-to-a-long-random-string

# --- LinkedIn auth: recommended path -----------------------------------
# Log in to linkedin.com in a real browser, then copy these two cookie
# values from DevTools > Application > Cookies (see README "Getting your
# session cookie"). This avoids ever automating the login form itself.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# --- LinkedIn auth: fallback path (not recommended) ---------------------
# Only used if LINKEDIN_LI_AT is not set. LinkedIn frequently challenges
# programmatic logins with a CAPTCHA/verification code from server IPs.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Minimum ms between requests this server sends to LinkedIn.
LINKEDIN_MIN_REQUEST_INTERVAL_MS=1500

# How long a fetched profile is cached in memory (ms) before re-fetching.
PROFILE_CACHE_TTL_MS=21600000

# Set to "true" to allow callers to pass ?includeRaw=true and get the raw
# upstream LinkedIn payload back too (useful when LinkedIn reshapes their
# API and the mapper needs updating). Keep false in production.
ENABLE_RAW_DEBUG=false
